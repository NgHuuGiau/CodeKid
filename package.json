{
  "name": "codekid-academy",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node --test tests/api.test.mjs",
    "test:dotnet": "dotnet test backend/CodeKid.Tests",
    "test:ui": "npm --prefix frontend run test:ui",
    "test:compose": "node scripts/smoke-compose.mjs",
    "test:e2e": "node scripts/e2e-production.mjs",
    "api": "dotnet run --project backend/CodeKid.Api --no-launch-profile -- --environment Development"
  }
}
