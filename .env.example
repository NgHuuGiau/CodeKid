# Sao chép thành .env; dùng mật khẩu ngẫu nhiên, không commit .env.
DB_PASSWORD=
RUNNER_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tùy chọn: tạo sẵn một giáo viên (và gán làm chủ khóa học) để trình diễn luồng lớp học.
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NICKNAME=
# Production bắt buộc HTTPS và SMTP thật; HTTP chỉ để health check trước khi cấu hình proxy TLS.
PUBLIC_URL=https://codekid.example.com
ALLOWED_HOSTS=localhost;127.0.0.1;api;codekid.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
# Sau khi kiểm thử, pin image bằng digest của image Python đã kiểm tra trên máy triển khai.
RUNNER_IMAGE=python:3.13-alpine
